<Window x:Class="UP01_Ibragimov_Delivery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Closing="Window_Closing"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01_Ibragimov_Delivery"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">

    <Grid>
        <!-- 1. Сначала ОБЯЗАТЕЛЬНО объявляем строки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- 2. Теперь размещаем элементы по строкам -->

        <!-- Выбор темы (верхняя строка, Grid.Row="0" по умолчанию) -->
        <ComboBox x:Name="ThemeComboBox" HorizontalAlignment="Right" VerticalAlignment="Center" Width="150" Margin="0,0,10,0" SelectionChanged="ThemeComboBox_SelectionChanged">
            <ComboBoxItem Content="Светлая тема" IsSelected="True"/>
            <ComboBoxItem Content="Тёмная тема"/>
        </ComboBox>

        <!-- Кнопка "Назад" (верхняя строка) -->
        <Button x:Name="BtnBack" Content="Назад" Width="80" Height="30" Margin="10,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BtnBack_Click"/>

        <!-- Контейнер Frame для смены страниц (средняя строка, Grid.Row="1") -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <!-- Время (нижняя строка, Grid.Row="2") -->
        <TextBlock x:Name="DateTimeNow" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" FontWeight="Bold"/>

    </Grid>
</Window>